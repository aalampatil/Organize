{
  "name": "@organize/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts test/core/*.test.ts",
    "test:integration": "tsx --env-file-if-exists=.env --test test/integration/*.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@organize/contracts": "*",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "cloudinary": "^2.8.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.6.2",
    "nodemailer": "^7.0.10",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3",
    "resend": "^6.4.2",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.4.3",
    "@types/nodemailer": "^7.0.3",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.31.6"
  }
}
